# Production template. On the server: `cp .env.production.example .env`, then fill in every
# placeholder below (secrets, DB password, mail credentials). The real `.env` is gitignored and
# must never be committed. This same file is read both by `docker compose -f docker-compose.prod.yml`
# (variable substitution) and by Laravel itself (it's bind-mounted into the containers as /var/www/.env).

APP_NAME="Auto Peças Center"
APP_SLUG=autopecascenter
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://autopecascenter.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=${APP_SLUG}-postgresql
DB_PORT=5432
DB_DATABASE=autopecascenter
DB_USERNAME=autopecascenter
# Generate a strong password (e.g. `openssl rand -base64 32`) — must match POSTGRES_PASSWORD below.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# TLS is terminated by this same nginx (see .docker/nginx/sites-production/laravel.conf) — cookies
# must be marked Secure so browsers refuse to send them over a plain-HTTP fallback.
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outlook/Microsoft 365 SMTP. NOTE: Microsoft has been retiring Basic Auth (username+password)
# for SMTP AUTH on consumer outlook.com mailboxes in favor of OAuth2 — if sending fails with an
# auth error, confirm this mailbox still allows SMTP AUTH (or generate an App Password for it
# under https://account.live.com/proofs/AppPassword) before assuming the config below is wrong.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-mail.outlook.com
MAIL_PORT=587
MAIL_USERNAME=autopecascenter.suporte@outlook.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="autopecascenter.suporte@outlook.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Shared secret required in the X-Api-Key header of POST /api/catalogs/import.
# Generate a strong one, e.g.: openssl rand -hex 32
CATALOG_IMPORT_API_KEY=

VITE_APP_NAME="${APP_NAME}"

###########################################################
############## docker-compose.prod.yml settings ###########
###########################################################

# Point this at wherever the app was actually checked out on the server.
APP_CODE_PATH_HOST=./
APP_CODE_PATH_CONTAINER=/var/www
APP_CODE_CONTAINER_FLAG=

VOLUMES_DRIVER=local
NETWORKS_DRIVER=bridge

COMPOSE_PROJECT_NAME=${APP_SLUG}

PHP_VERSION=8.4

WORKSPACE_TIMEZONE=America/Sao_Paulo

### NGINX #################################################
NGINX_HOST_HTTP_PORT=80
NGINX_HOST_HTTPS_PORT=443
NGINX_HOST_LOG_PATH=.docker/logs/nginx/
NGINX_SITES_PATH=.docker/nginx/sites-production/
NGINX_SSL_PATH=.docker/nginx/ssl/production/
NGINX_DOCKERFILE=Dockerfile

### POSTGRES ##############################################
POSTGRES_VERSION=17
POSTGRES_CLIENT_VERSION=15
POSTGRES_DB=autopecascenter
POSTGRES_USER=autopecascenter
# Must match DB_PASSWORD above.
POSTGRES_PASSWORD=
# Only used if you uncomment the `ports:` block on the postgres service in docker-compose.prod.yml.
POSTGRES_PORT=5432
